# GeoTrail Environment Configuration
# Copy this to .env and update values for your environment

# Database
DB_PASSWORD=your_secure_password_here

# JWT — generate with: openssl rand -base64 32
JWT_SECRET=your-256-bit-secret-key-change-in-production-please

# MinIO (S3-compatible object storage)
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=your_minio_secret_here

# Optional: Frontend URL (for CORS in production)
FRONTEND_URL=http://localhost:4200
